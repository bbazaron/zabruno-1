UID=1000
GID=1000

# Корень публичного storage внутри контейнера backend.
# Nginx отдаёт /storage/ из ./backend/storage/app/public (в контейнере nginx это /var/www/backend/storage/app/public).
APP_PUBLIC_STORAGE_ROOT=/var/www/storage/app/public

# Очередь приложения; письма OrderReceived всегда через соединение database.
QUEUE_CONNECTION=database

# Имя очереди для OrderReceived (воркер: php artisan queue:work database --queue=mail)
ORDER_MAIL_QUEUE=mail

# RabbitMQ (опционально, для других продюсеров/консьюмеров)
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=zabruno
RABBITMQ_PASSWORD=zabruno
RABBITMQ_VHOST=/
RABBITMQ_QUEUE=default